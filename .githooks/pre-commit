#!/bin/sh
# Block a commit when formatting, vet or tests fail. Runs Go in the container via ./dev.
set -eu
cd "$(git rev-parse --show-toplevel)"
unformatted=$(./dev gofmt -l cmd internal)
if [ -n "$unformatted" ]; then
  echo "pre-commit: gofmt needed on:" >&2
  echo "$unformatted" >&2
  exit 1
fi
./dev go vet ./...
# same check as CI: go.mod and go.sum must already be tidy
./dev go mod tidy
if ! git diff --quiet -- go.mod go.sum; then
  echo "pre-commit: go mod tidy changed go.mod/go.sum; stage the result" >&2
  exit 1
fi
./dev go test -count=1 ./...
